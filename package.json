{
  "name": "merelaager-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc -b",
    "sass": "sass --style=compressed ./styles/global.scss ./app/global.css",
    "reload": "yarn sass && yarn build && yarn start"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "dotenv": "^17.2.3",
    "http-status-codes": "^2.3.0",
    "isbot": "^5.1.32",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prisma": "^6.19.1",
    "sass": "^1.97.1",
    "typescript": "^5.9.3",
    "vite": "8.0.16"
  },
  "packageManager": "yarn@4.18.1"
}
